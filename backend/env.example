# JWT Authentication
JWT_SECRET="some random secret key"
JWT_ALGORITHM="HS256"
TOKEN_TIMEOUT=30

# Database Configuration
DB_URL="sqlite:///database.db"

# Server & API Routing
PORT=8082
API_PREFIX="/api" # Backend API folder / path prefix (default: /api)
CORS_ORIGINS="*" # Allowed CORS origins, comma-separated or wildcard (e.g. "http://localhost:5173,http://localhost:3000" or "*")

# Fuzzy Search (Optional)
SEARCH_MATCH_THRESHOLD=75 # Fuzzy match threshold (0-100), default: 75

# Power Curve Cron Job (Optional)
POWER_CURVE_PERIODS="3,6,12" # Periods in months
POWER_CURVE_CRON_FREQUENCY_HOURS=24 # Frequency in hours to run full recomputation
